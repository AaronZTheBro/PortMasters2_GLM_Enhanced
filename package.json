{
  "name": "portmasters2",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "cross-env NODE_ENV=development node --import tsx server.ts",
    "build": "cross-env NODE_ENV=production prisma generate && cross-env NODE_ENV=production next build --webpack",
    "start": "npm run db:push && cross-env NODE_ENV=production node --import tsx server.ts",
    "lint": "eslint .",
    "test:unit": "node --import tsx --test tests/game-rules.test.ts tests/expansion.test.ts tests/open-harbor.test.ts tests/reagents.test.ts",
    "test:integration": "node --import tsx --test tests/server.integration.test.ts",
    "test:balance:harbor": "node --import tsx tests/open-harbor-balance.ts",
    "test:balance": "node --import tsx tests/voyage-balance.ts",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm test && npm run typecheck",
    "verify": "npm run check && npm run build",
    "db:push": "node --import tsx src/server/prepareDatabase.ts && prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "prisma": "^7.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.19.2",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "overrides": {
    "@prisma/config@7.10.1": {
      "effect": "3.22.5"
    }
  }
}
